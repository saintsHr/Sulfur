namespace std::math {

pub fn pow(mut i64 base, mut u64 exp) i64 {
    mut i64 result = 1;

    while (exp > 0) {
        u64 h = exp / 2;

        if (h * 2 != exp) {
            result *= base;
        }

        base *= base;
        exp = h;
    }

    return result;
}

pub fn sqrt(u64 n) u64 {
    if (n <= 0) {
        return 0;
    }

    mut u64 x = n;
    mut u64 y = (x + 1) / 2;

    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }

    return x;
}

pub fn abs(i64 n) u64 {
    if (n < 0) {
        return -(n + 1) as u64 + 1;
    } else {
        return n as u64;
    }
}

pub fn max(i64 a, i64 b) i64 {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

pub fn min(i64 a, i64 b) i64 {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

pub fn clamp(i64 n, i64 min, i64 max) i64 {
    if (n > max) {
        return max;
    }
    if (n < min) {
        return min;
    }

    return n;
}

pub fn gcd(mut i64 a, mut i64 b) i64 {
    a = abs(a) as i64;
    b = abs(b) as i64;

    while (b != 0) {
        i64 r = a - (a / b) * b;
        a = b;
        b = r;
    }

    return a;
}

pub fn lcm(i64 a, i64 b) i64 {
    if (a == 0 || b == 0) {
        return 0;
    }

    return abs((a / gcd(a, b)) * b) as i64;
}

}
